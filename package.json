{
  "name": "vite-svelte-ts-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "format": "dprint fmt && prettier --write \"**/*.svelte\"",
    "format:check": "dprint check && prettier --check \"**/*.svelte\"",
    "format:dprint": "dprint fmt",
    "format:prettier": "prettier --write \"**/*.svelte\""
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/file-saver": "^2.0.7",
    "@vitest/ui": "^3.2.4",
    "dprint": "^0.50.2",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.39.11",
    "svelte-check": "^4.0.0",
    "tslib": "^2.7.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "file-saver": "^2.0.5"
  }
}
